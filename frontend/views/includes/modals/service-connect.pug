//- Connect Service Modal
div(id="connectServiceModal", class="modal")
  div(class="bg-white p-8 rounded-2xl w-full max-w-lg shadow-2xl")
    .flex.justify-between.items-center.mb-6
      h3(class="text-xl font-bold text-slate-800") 注册新服务
      button(onclick="hideModal('connectServiceModal')", class="text-slate-400 hover:text-slate-600 transition")
        i(class="fas fa-times")

    form#connectServiceForm
      div(class="space-y-4 mb-6")
        //- 服务名称
        div
          label(class="block text-xs font-bold text-slate-700 mb-1") 服务实例名称 (Instance Name)
          input(type="text", name="service_name", placeholder="例如: llama3-production", class="w-full border border-slate-200 p-2.5 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none", required)
          p(class="text-[10px] text-slate-400 mt-1") * 用于区分同一节点上的多个服务

        //- 注册模式选择
        div
          label(class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2") 注册模式 (Registration Mode)
          div(class="flex gap-4 bg-slate-50 p-1 rounded-xl border border-slate-100")
            label(class="flex-1 cursor-pointer")
              input(type="radio", name="mode", value="new_deployment", class="hidden peer", onchange="toggleServiceConnectMode(this.value)", checked)
              div(class="text-center py-2 rounded-lg text-sm font-bold text-slate-500 peer-checked_bg-white peer-checked_text-blue-600 peer-checked_shadow-sm transition") 托管部署 (New)
            label(class="flex-1 cursor-pointer")
              input(type="radio", name="mode", value="integrate_existing", class="hidden peer", onchange="toggleServiceConnectMode(this.value)")
              div(class="text-center py-2 rounded-lg text-sm font-bold text-slate-500 peer-checked_bg-white peer-checked_text-blue-600 peer-checked_shadow-sm transition") 对接现有 (Existing)

        div(class="grid grid-cols-2 gap-4")
          div
            label(class="block text-xs font-bold text-slate-700 mb-1") 服务类型 (Type)
            select(name="service_type", class="w-full border border-slate-200 p-2.5 rounded-lg bg-white focus:ring-2 focus:ring-blue-500 outline-none", required)
              option(value="inference") 推理引擎 (Inference)
              option(value="rag") RAG 应用 (AnythingLLM)
              option(value="vectordb") 向量数据库 (Vector DB)
              option(value="parser") 文档解析器 (Parser)
          
          div
            label(class="block text-xs font-bold text-slate-700 mb-1") 目标节点 (Target Node)
            select#connect-node-select(name="target_node", class="w-full border border-slate-200 p-2.5 rounded-lg bg-white focus:ring-2 focus:ring-blue-500 outline-none", required)
              option(value="", disabled, selected) 加载中...
        
        div(class="grid grid-cols-2 gap-4")
          div
            label(class="block text-xs font-bold text-slate-700 mb-1") 端口 (Port)
            input(type="number", name="port", placeholder="8000", class="w-full border border-slate-200 p-2.5 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none", required)
          
          //- Managed only fields
          div.managed-only
            label(class="block text-xs font-bold text-slate-700 mb-1") 关联模型类型 (Model Type)
            select#connect-model-type(name="model_type_select", class="w-full border border-slate-200 p-2.5 rounded-lg bg-white focus:ring-2 focus:ring-blue-500 outline-none")
              option(value="", disabled, selected) 加载中...
        
        div.managed-only
          label(class="block text-xs font-bold text-slate-700 mb-1") 关联模型名称 (Model Name)
          select#connect-model-name(name="model_name_select", class="w-full border border-slate-200 p-2.5 rounded-lg bg-white focus:ring-2 focus:ring-blue-500 outline-none")
            option(value="", disabled, selected) 请先选择类型

        //- External mode fields
        div#external-fields.hidden.space-y-4.p-4.bg-slate-50.rounded-xl.border.border-slate-200
          div(class="grid grid-cols-2 gap-4")
            div
              label(class="block text-xs font-bold text-slate-700 mb-1") 外部模型类型 (Type)
              select#external-model-type(name="external_model_type", class="w-full border border-slate-200 p-2.5 rounded-lg bg-white")
                //- Populated by JS
            div
              label(class="block text-xs font-bold text-slate-700 mb-1") 外部模型名称 (Model Name)
              input(type="text", name="external_model_name", placeholder="例如: gpt-4", class="w-full border border-slate-200 p-2.5 rounded-lg")
          
          div
            label(class="block text-xs font-bold text-slate-700 mb-1") API Key (Optional)
            input(type="text", name="api_key", placeholder="sk-...", class="w-full border border-slate-200 p-2.5 rounded-lg")
          
          div
            label(class="block text-xs font-bold text-slate-700 mb-1") Base URL (Optional)
            input(type="text", name="base_url", placeholder="https://api.openai.com/v1", class="w-full border border-slate-200 p-2.5 rounded-lg")

        div#test-connection-group.hidden
          button(type="button", onclick="testServiceConnect()", class="w-full border border-blue-600 text-blue-600 py-2.5 rounded-lg text-sm font-bold hover:bg-blue-50 transition")
            i(class="fas fa-plug mr-2")
            | 测试连接 (Test Connection)

      div(class="flex justify-end gap-3 pt-6 border-t border-slate-100")
        button(type="button", onclick="hideModal('connectServiceModal')", class="px-6 py-2.5 text-slate-500 font-bold text-sm hover:bg-slate-100 rounded-lg transition") 取消
        button(type="submit", class="px-8 py-2.5 bg-blue-600 text-white rounded-lg font-bold text-sm shadow-lg shadow-blue-200 hover:bg-blue-700 transition") 确认注册