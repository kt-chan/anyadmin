{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Frontend",
      "program": "${workspaceFolder}/frontend/app.js",
      "cwd": "${workspaceFolder}/frontend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Run Backend (Go)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/server/main.go",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Deploy Agent",
      "type": "node",
      "request": "launch",
      "name": "Deploy Agent",
      "preLaunchTask": "deploy-agent"
    }
  ],
  "compounds": [
    {
      "name": "Run Full Stack",
      "configurations": [
        "Run Backend (Go)",
        "Run Frontend"
      ],
      "preLaunchTask": "stop-pids"
    }
  ]
}